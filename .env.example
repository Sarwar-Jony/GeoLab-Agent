# Google Gemini API Key (Recommended for Multi-Agent reasoning & policy synthesis)
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Google Earth Engine Cloud Project ID (Optional for Live GEE Authenticated queries)
# Leave blank to use built-in synthetic/cached satellite data mode
GEE_PROJECT_ID=

# Alternative LLM Provider (Optional)
OPENAI_API_KEY=
